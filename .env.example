# Copy to .env.local to override.
#
# Base URL the browser calls. Left at /v1, requests go through the Vite proxy
# to http://localhost:8080 (see vite.config.js) and there is no CORS at all.
VITE_API_BASE_URL=/v1

# Tenant sent as X-Tenant-Id while authentication is not wired.
# Matches the tenant created by the Flyway seed.
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Optional: user id recorded as the actor on every command (leg history).
# VITE_ACTOR_ID=
