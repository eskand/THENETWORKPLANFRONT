# nginx pour le front NetPlus — rendu au démarrage par l'image officielle
# (envsubst sur ${API_UPSTREAM}, voir Dockerfile).
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Sonde Kubernetes (readiness / liveness) : ne dépend pas de l'API.
    location = /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    # L'API, même origine : le navigateur ne fait aucune requête cross-origin.
    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Assets Vite : nom haché, cache long.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Application mono-page : toute route inconnue rend index.html
    # (react-router prend le relais côté client).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
